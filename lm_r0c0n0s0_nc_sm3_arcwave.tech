{
    stateMap "default";

    vertexShader 3.0 "deagle_arcwave_custom"
    {
    }

    pixelShader 3.0 "deagle_arcwave_custom"
    {
        colorMapSampler = material.colorMap;
        colorMapSampler1 = sampler.resolvedPostSun;
        colorMapSampler2 = material.normalMap;
        specularMapSampler = material.specularMap;
    }

    vertex.position = code.position;
    vertex.normal = code.normal;
    vertex.texcoord[0] = code.texcoord[0];
}